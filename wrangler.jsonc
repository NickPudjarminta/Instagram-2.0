// Cloudflare Workers deployment for Instagram 2.0. Deploy with `npm run deploy`
// (needs CLOUDFLARE_API_TOKEN, and CLOUDFLARE_ACCOUNT_ID if the token can see several accounts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pulse-news",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
